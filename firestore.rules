rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the admin account (created in Firebase Authentication) can manage data.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@jeek-store.com';
    }

    function str(v, max) { return v is string && v.size() <= max; }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','docId','uid','createdAtMs','date','status','total','customerName',
                               'phone','paymentMethod','address','notes','items'])
        && (!('uid' in d) || (request.auth != null && d.uid == request.auth.uid))
        && d.status == 'Preparing'
        && d.total is number && d.total >= 0
        && str(d.customerName, 120) && d.customerName.size() > 0
        && str(d.phone, 40) && d.phone.size() >= 5
        && str(d.address, 500) && d.address.size() > 0
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50;
    }

    function validMaintenance() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','docId','createdAtMs','date','estimatedCompletion','status',
                               'customerName','phone','address','serviceMode','serviceModeAr',
                               'bikeModel','bikeModelAr','frameElement','frameElementAr','serialNumber',
                               'servicePackage','servicePackageAr','reportedIssue','reportedIssueAr',
                               'technician','technicianNotes','checklist','charges','total'])
        && d.status == 'Preparing'
        && str(d.customerName, 120) && d.customerName.size() > 0
        && str(d.phone, 40) && d.phone.size() >= 5
        && str(d.address, 500) && d.address.size() > 0
        && str(d.reportedIssue, 2000)
        && d.checklist is list && d.checklist.size() <= 20
        && d.charges is list && d.charges.size() == 0;
    }

    // Public catalog: everyone reads, only admin writes.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Storefront maintenance-page settings are public; the "meta" doc is admin-only.
    match /config/{id} {
      allow read: if id == 'maintenance' || isAdmin();
      allow write: if isAdmin();
    }

    // Customers can create an order and follow it by its private random id, but nobody
    // can list/browse other people's orders. Only the admin can list and update them.
    match /orders/{id} {
      allow get: if true;
      allow list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if validOrder();
      allow update, delete: if isAdmin();
    }

    match /maintenanceOrders/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validMaintenance();
      allow update, delete: if isAdmin();
    }
  }
}
